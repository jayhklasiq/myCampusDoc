# Anthropic API key used by the server-side chat endpoint (server/).
# Get one at https://console.anthropic.com/settings/keys
# Required for the Chat feature to generate real responses.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for chat replies.
# Defaults to claude-opus-5 if unset.
ANTHROPIC_MODEL=claude-opus-5

# Optional: port the backend API server listens on (also used by Vite's
# dev proxy target). Defaults to 3001 if unset.
PORT=3001
