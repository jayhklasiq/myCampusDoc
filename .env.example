# Primary AI provider — used for all chat requests by default.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for chat replies.
# Defaults to claude-opus-5 if unset.
ANTHROPIC_MODEL=claude-opus-5

# Automatic fallback provider (optional).
# Used only when Anthropic reports insufficient account credits — the exact
# same chat request (system prompt + full conversation history) is retried
# through RodiumAI, transparently to the user. Leave RODIUM_API_KEY blank to
# disable the fallback (chat will simply show an error if Anthropic runs out
# of credits). If ANTHROPIC_API_KEY is left blank but this is set, Rodium is
# used as the sole provider instead.
RODIUM_API_KEY=

# Optional: override the Rodium model. Must use the "<brand>/<model>" format
# Rodium expects (e.g. "anthropic/claude-opus-5") — NOT a bare model name
# like "claude-opus-5". Defaults to anthropic/claude-opus-5 if unset.
RODIUM_MODEL=anthropic/claude-opus-5

# Optional: port the backend API server listens on (also used by Vite's
# dev proxy target). Defaults to 3001 if unset.
PORT=3001
